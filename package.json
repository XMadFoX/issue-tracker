{
	"name": "prism-tracker",
	"version": "1.0.0",
	"scripts": {
		"db:migrate": "FORCE_COLOR=3 bun --env-file=.env -F db migrate",
		"dev": "FORCE_COLOR=3 bun --env-file=.env -F tss-web dev",
		"test": "bun -F tss-web test",
		"test:unit": "bun -F tss-web test:unit",
		"test:unit:watch": "bun -F tss-web test:unit:watch",
		"test:e2e": "bun -F tss-web test:e2e",
		"test:e2e:ui": "bun -F tss-web test:e2e:ui",
		"typecheck": "bun --workspaces --if-present run typecheck"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "bun@1.2.23",
	"devDependencies": {
		"typescript": "5.9.3"
	},
	"overrides": {
		"pg": "8.17.1",
		"bun-types": "1.3.8",
		"@types/bun": "1.3.8",
		"vite": "^8.0.0-beta.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"react": "^19.2.4",
		"drizzle-orm": "1.0.0-rc.2",
		"react-dom": "^19.2.4"
	}
}
